/* components/apply-member/apply-member.wxss */
@import "../../app.wxss";
.mask{
  position: fixed;
  left: 0;
  right: 0;
  top:0;
  bottom: 0;
  background-color:rgba(0, 0, 0, 0.8)
}
.dialog_box{
  background-color: #ffffff;
  border-radius: 10px;
  overflow: hidden;
}
.dialog{
  width: 664rpx;
  height: 210rpx;
  background: #FFBE30;

  flex-direction: column;
  box-sizing: border-box;
  padding: 0 55rpx;
  position: relative;
}
.tip_text{
  font-size: 42rpx;
  font-weight: 400;
  color:#ffffff;
  width: 100%;
}
.close{
  position: absolute;
  top:16rpx;
  right: 16rpx;
}
.content{
  width: 664rpx;
  /* height: 872rpx; */
  background: #FFFFFF;
  border-radius: 10px;
  box-sizing: border-box;
  padding-top: 55rpx;
  padding-bottom: 50rpx;
}
.item{
  width: 85%;
  box-sizing: border-box;
  margin:0 auto;
  align-items:flex-start;
}
.title
{
  width: 48rpx;
  line-height: 46rpx;
  background: #CBCBCB;
  border-radius: 50%;
  font-size: 28rpx;
  text-align: center;
  font-weight: 400;
  color: #FFFFFF;
  margin-right: 11rpx;
  box-sizing: border-box;
}
.title_content{
  font-size: 28rpx;
font-weight: 400;
}
.nv{
  width: 70%;
  height: 90rpx;
  border: 2rpx solid #FFBE30;
  border-radius: 8rpx;
  margin:0 auto;
  font-size: 32rpx;
  font-family: PingFang SC;
  font-weight: 400;
  color: #FFBE30;
  line-height: 90rpx;
  text-align: center;
  margin-top: 30rpx;
  margin-bottom: 48rpx;
}
.vip{
  position: absolute;
  top:87rpx;
  right: 37rpx;
}
.qr
{
  width: 260rpx;
  height: 260rpx;
  background: #FFFFFF;
  border: 2px dashed #EEECEF;
  margin:0 auto;
  margin-top: 30rpx;
}
.show{
  pointer-events: all;
  opacity: 1;
  transition: all linear 0.2s;
}
.hide{
  pointer-events: all;
  opacity: 0;
  transition: all linear 0.2s;
  pointer-events: none;
}