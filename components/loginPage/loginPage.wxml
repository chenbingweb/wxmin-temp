<form bindsubmit="onFormSubmit">
  <view class="pannel" wx:if="{{false}}">

    <view class="item">
      <view class="input_box">
        <input name="mobile" placeholder-class="placeholder" bindinput="onInput" value="{{mobile}}" type="number" class="input_item" placeholder='请输入手机号'></input>
      </view>
    </view>
    <!-- 验证码 -->
    <view class="item line_0" style="margin-bottom:0;">
      <view class="input_box">
        <input name="check_code" placeholder-class="placeholder" type="number" value="{{check_code}}" bindinput="onInputCode" class="input_item" style="width:500rpx" placeholder='请输入验证码'></input>
      </view>
      <view wx:if="{{count<=0}}" class="check_box" bindtap="onGetCode">
        获取验证码
      </view>
      <view wx:else class="check_box">
        {{count+'S'}}
      </view>
    </view>
  </view>
  <view wx:if="{{false}}" class="flex_start role">
    <view class="flex_start" bindtap="onSelect">
      <view class="flex_center">
        <image src="../../images/{{selected?'select_check_yes':'select_check_no'}}.png" style="width:24rpx;height:24rpx"> </image>
      </view>
      <view style="margin-left:10rpx;" class="f_26_9b9b9b">已阅读并同意</view>
    </view>
    <navigator url="../help/help?src=xy" class="f_26_6a7fa6">《使用协议》</navigator>
  </view>
  <!-- wx:if="{{false}}" -->
  <view class="box"  wx:if="{{false}}">
      <view class="flex_center img_box_av" style="margin-bottom:20rpx">
        <view wx:if="{{!userInfo.avatar}}" style="width: 120rpx;height: 120rpx;position: relative;">
          <avatar/>
          <button class="btn_login" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar"></button> 
        </view>
        <image wx:else class="img" src="{{userInfo.avatar}}"></image>
      </view>
      <view class="name_box">
        <view class="flex_start">
            <view style="font-size: 30rpx;margin-right: 20rpx;width:140rpx;text-align: right;">
              昵称:
            </view>
            <view class="flex_start"  style="font-size: 30rpx;width: 80%;">
              <input type="nickname" placeholder-class="placeholder"  class="weui-input" placeholder="请输入昵称" style="width: 100%;"/>
            </view>
        </view>
      </view>
      <view class="name_box">
        <view class="flex_start">
            <view style="font-size: 30rpx;margin-right: 20rpx;width:140rpx;text-align: right;">
              手机号码:
            </view>
            <view class="flex_start"  style="font-size: 30rpx;width: 340rpx; margin-right: 20rpx;">
              <input disabled placeholder-class="placeholder" class="weui-input" placeholder="点击右侧获取手机号码" style="width: 100%;"/>
            </view>
            <view class="check_box relative" style="    font-size: 21rpx;width: 164rpx;line-height: 46rpx;">
              获取手机号码
              <button open-type="getPhoneNumber" class="btn_login" bindgetphonenumber="onGetPhone"></button>
            </view>
        </view>
      </view>
  </view>
  <view class="phone_box" wx:if="{{type=='edit'}}" >
      <view class="input_box">
        <input name="check_code" disabled placeholder-class="placeholder" type="number" value="{{mobile}}" bindinput="onInputCode" class="input_item" style="width:500rpx" placeholder='点击右侧获取手机号码'></input>
      </view>
      <view class="check_box relative">
        获取手机号码
        <button open-type="getPhoneNumber" class="btn_login" bindgetphonenumber="onGetPhone"></button>
      </view>
  </view>
  <view wx:if="{{type=='edit'}}"  class="submit_btn {{mobile_code?'':'disable'}}" style="position:relative" bindtap="onGotUserInfo">
    {{type=='edit'?'修改':'注册'}}
 
    <!-- <button open-type="getUserInfo" lang="zh_CN" bindgetuserinfo="onGotUserInfo" class="btn_login"></button> -->
  </view>
  <view wx:else class="submit_btn " style="position:relative;margin-top: 160rpx;" bindtap="onGotUserInfo">
    注册
    <!-- <button open-type="getUserInfo" lang="zh_CN" bindgetuserinfo="onGotUserInfo" class="btn_login"></button> -->
  </view>
  <!-- <view class="back" bindtap="onBack">返回</view> -->
</form>
<user-info id="userInfo" bindconfirm="confirmNickName"></user-info>