/* components/user-info/user-info.wxss */
@import "../../app.wxss";
.user_bg
{
  width: 100%;
  height: 100%;
  position: fixed;
  left: 0;
  top:0;
  background-color: rgba(0, 0, 0, 0.8);
  z-index: 999999999999999999999;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all linear 0.2s;
}
.box
{
    width: 562rpx;
    background: #fff;
    opacity: 1;
    border-radius: 10rpx;
    box-sizing: border-box;
    padding: 30rpx;
    padding-top: 60rpx;
    transform: translateY(-80rpx);
    position: relative;
}
.title
{
  /* width: 64rpx; */
  height: 45rpx;
  font-size: 32rpx;

  font-weight: 400;
  line-height: 45rpx;
  color: #121212;
  opacity: 1;
}
.item_box{
  width: 480rpx;
height: 88rpx;
background: #F5F6F7;
opacity: 1;
border-radius: 10rpx;
margin-top: 10px;
box-sizing: border-box;
padding: 14rpx;

}
.weui-input{
  font-size: 26rpx;
}
.get_nick{
  width: 140rpx;
height: 60rpx;
border: 2rpx solid #FDBE30;
opacity: 1;
border-radius: 6rpx;
font-size: 26rpx;
font-family: PingFang SC;
font-weight: 400;
line-height: 60rpx;
color: #FDBE30;
opacity: 1;
text-align: center;
}
.btn_confirm{
  width: 480rpx;
  height: 88rpx;
  background: #FDBE30;
  opacity: 1;
  border-radius: 10rpx;
  font-size: 34rpx;
  font-family: PingFang SC;
  font-weight: 500;
  line-height: 88rpx;
  color: #FFFFFF;
  opacity: 1;
  text-align: center;
  margin-top: 40rpx;
}
.disable{
  opacity: 0.7;
}
.hide{
  opacity: 0;
  pointer-events: none;
}
.show{
  opacity: 1;
  pointer-events: all;
}
.close{
  position: absolute;
  right: 10rpx;
  top:10rpx;
  width: 55rpx;
  height: 55rpx;
}